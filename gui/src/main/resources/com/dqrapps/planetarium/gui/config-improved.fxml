<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="520.0" prefWidth="700.0"
            style="-fx-background-color: linear-gradient(to bottom, #ecf0f1 0%, #bdc3c7 100%);"
            xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dqrapps.planetarium.gui.config.ConfigController">
   <children>
      <VBox alignment="CENTER" prefHeight="520.0" prefWidth="700.0" spacing="15.0">
         <children>
            <!-- Header Section with improved styling -->
            <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 8; -fx-padding: 15;">
               <Label text="🔭 Observation Configuration" style="-fx-text-fill: white;">
                  <font>
                     <Font name="System Bold" size="32.0" />
                  </font>
               </Label>
               <Label text="Configure your location and observation parameters" style="-fx-text-fill: #ecf0f1;">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
            </VBox>

            <Separator style="-fx-background-color: #34495e; -fx-pref-height: 2;"/>

            <!-- Main Configuration Grid -->
            <GridPane prefHeight="260.0" prefWidth="660.0" hgap="15.0" vgap="15.0"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="200.0" minWidth="160.0" prefWidth="180.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="450.0" minWidth="250.0" prefWidth="420.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- Configuration Name -->
                  <Label text="📋 Configuration:" GridPane.rowIndex="0" style="-fx-text-fill: #2c3e50;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="configName" editable="false" promptText="Configuration identifier" GridPane.columnIndex="1" GridPane.rowIndex="0"
                             style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-background-radius: 4;">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <tooltip>
                        <Tooltip text="Name of this saved configuration" showDelay="300ms"/>
                     </tooltip>
                  </TextField>

                  <!-- Longitude -->
                  <Label text="🌍 Longitude:" GridPane.rowIndex="1" style="-fx-text-fill: #2c3e50;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <TextField fx:id="longHours" promptText="-112.03884" prefWidth="200.0"
                                   style="-fx-border-color: #3498db; -fx-border-radius: 4; -fx-background-radius: 4;">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <tooltip>
                              <Tooltip text="Enter longitude in decimal degrees&#10;Example: -112.03884 (West is negative)&#10;Range: -180 to +180" showDelay="300ms"/>
                           </tooltip>
                        </TextField>
                        <Label text="° (W = negative)" textFill="#7f8c8d" style="-fx-font-weight: 600;">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <!-- Latitude -->
                  <Label text="🧭 Latitude:" GridPane.rowIndex="2" style="-fx-text-fill: #2c3e50;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <TextField fx:id="latHours" promptText="40.68329" prefWidth="200.0"
                                   style="-fx-border-color: #3498db; -fx-border-radius: 4; -fx-background-radius: 4;">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <tooltip>
                              <Tooltip text="Enter latitude in decimal degrees&#10;Example: 40.68329 (South is negative)&#10;Range: -90 to +90" showDelay="300ms"/>
                           </tooltip>
                        </TextField>
                        <Label text="° (S = negative)" textFill="#7f8c8d" style="-fx-font-weight: 600;">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <!-- Observation Date -->
                  <Label text="📅 Date:" GridPane.rowIndex="3" style="-fx-text-fill: #2c3e50;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <DatePicker fx:id="viewDate" prefWidth="200.0" promptText="Select date"
                                    style="-fx-border-color: #3498db; -fx-border-radius: 4;">
                           <tooltip>
                              <Tooltip text="Select observation date" showDelay="300ms"/>
                           </tooltip>
                        </DatePicker>
                        <Label text="(mm/dd/yyyy)" textFill="#7f8c8d" style="-fx-font-weight: 600;">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <!-- Sidereal Time -->
                  <Label text="⏰ Sidereal Time:" GridPane.rowIndex="4" style="-fx-text-fill: #2c3e50;">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="4">
                     <children>
                        <TextField fx:id="siderealTime" promptText="HH:MM" prefWidth="140.0"
                                   style="-fx-border-color: #3498db; -fx-border-radius: 4; -fx-background-radius: 4;">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <tooltip>
                              <Tooltip text="Local Sidereal Time&#10;Format: HH:MM (24-hour)&#10;Example: 08:02" showDelay="300ms"/>
                           </tooltip>
                        </TextField>
                        <Label text="(24-hour format)" textFill="#7f8c8d" style="-fx-font-weight: 600;">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <!-- Help Text -->
                  <HBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5"
                        style="-fx-background-color: #e8f5e9; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #27ae60; -fx-border-radius: 6;">
                     <children>
                        <Label text="💡" style="-fx-font-size: 18px;"/>
                        <Label text=" Quick Tip: Use 'Load Config' menu to switch between saved observation locations. You can save multiple locations for easy access!"
                               textFill="#27ae60" wrapText="true" style="-fx-font-weight: 600;">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </GridPane>

            <Separator style="-fx-background-color: #34495e; -fx-pref-height: 2;"/>

            <!-- Display Preferences Section with improved layout -->
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);">
               <Label text="🎨 Display Preferences" style="-fx-text-fill: #2c3e50;">
                  <font>
                     <Font name="System Bold" size="16.0" />
                  </font>
               </Label>

               <HBox spacing="25.0" alignment="CENTER_LEFT">
                  <children>
                     <CheckBox fx:id="showConstellationsCheckbox" text="⭐ Constellation Lines" selected="true"
                               style="-fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-font-weight: 600;">
                        <tooltip>
                           <Tooltip text="Draw lines connecting constellation stars" showDelay="300ms"/>
                        </tooltip>
                     </CheckBox>
                     <CheckBox fx:id="showGridCheckbox" text="📐 RA/Dec Grid" selected="false"
                               style="-fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-font-weight: 600;">
                        <tooltip>
                           <Tooltip text="Show celestial coordinate grid" showDelay="300ms"/>
                        </tooltip>
                     </CheckBox>
                     <CheckBox fx:id="showDSOCheckbox" text="🌌 Deep Sky Objects" selected="true"
                               style="-fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-font-weight: 600;">
                        <tooltip>
                           <Tooltip text="Show nebulae, galaxies, and clusters" showDelay="300ms"/>
                        </tooltip>
                     </CheckBox>
                     <CheckBox fx:id="showPlanetsCheckbox" text="🪐 Planets" selected="true"
                               style="-fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-font-weight: 600;">
                        <tooltip>
                           <Tooltip text="Show planets in the solar system" showDelay="300ms"/>
                        </tooltip>
                     </CheckBox>
                  </children>
               </HBox>
            </VBox>

            <Separator style="-fx-background-color: #34495e; -fx-pref-height: 2;"/>

            <!-- Action Buttons with improved styling -->
            <ButtonBar prefHeight="50.0" prefWidth="660.0" style="-fx-padding: 10 0 0 0;">
               <buttons>
                  <MenuButton fx:id="loadConfigMenu" mnemonicParsing="false" onAction="#loadAction" onMouseClicked="#loadAction"
                              text="📂 Load Config" styleClass="secondary"
                              style="-fx-min-width: 120px;">
                     <items>
                        <MenuItem mnemonicParsing="false" text="default" />
                     </items>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <tooltip>
                        <Tooltip text="Load a saved configuration" showDelay="300ms"/>
                     </tooltip>
                  </MenuButton>

                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#saveAction" text="💾 Save Config" styleClass="primary"
                          style="-fx-min-width: 120px;">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <tooltip>
                        <Tooltip text="Save current configuration" showDelay="300ms"/>
                     </tooltip>
                  </Button>

                  <Button fx:id="newButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#clearConfigForm"
                          text="📝 New Config" styleClass="secondary"
                          style="-fx-min-width: 120px;">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <tooltip>
                        <Tooltip text="Create a new configuration" showDelay="300ms"/>
                     </tooltip>
                  </Button>

                  <Button fx:id="deleteButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#deleteAction"
                          text="🗑 Delete Config"
                          style="-fx-min-width: 120px; -fx-background-color: #e74c3c;">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <tooltip>
                        <Tooltip text="Delete current configuration" showDelay="300ms"/>
                     </tooltip>
                  </Button>

                  <Button fx:id="ExitButton" onAction="#switchToPlot" text="◀ Back to Plot"
                          style="-fx-min-width: 130px; -fx-font-weight: bold; -fx-background-color: linear-gradient(to bottom, #27ae60 0%, #229954 100%);">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <tooltip>
                        <Tooltip text="Return to star plot view" showDelay="300ms"/>
                     </tooltip>
                  </Button>
               </buttons>
            </ButtonBar>
         </children>
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
